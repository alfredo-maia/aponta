# ─── PostgreSQL ─────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aponta
POSTGRES_PORT=5432

# ─── API (NestJS) ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aponta?schema=public
JWT_SECRET=change-me-to-a-strong-secret-in-production
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development
# Knowledge base attachments (D-09/S4.0): outside ./uploads (served
# statically at /uploads), so a PRIVATE article's file is never reachable
# by a bare URL — only through the download route.
KNOWLEDGE_PRIVATE_UPLOADS_DIR=uploads-private/knowledge

# ─── Web (Vite) ─────────────────────────────────────────────────────────
WEB_PORT=3000
VITE_API_URL=http://localhost:3001
