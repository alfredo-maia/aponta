generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  AGENT_MASTER
  AGENT
  CLIENT_MASTER
  CLIENT
}

enum TicketSource {
  WEB
  EMAIL
  WHATSAPP
}

enum TicketStatus {
  ESCALATED
  PENDING_CUSTOMER
  ON_HOLD
  PENDING_APPROVAL
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ServiceDeskReviewType {
  INTERNAL
  CLIENT
  BOTH
}

enum ServiceDeskSectionKey {
  GENERAL_INFO
  CATEGORY
  SERVICE_TYPE
  WORKLOGS
  COMMUNICATION
  APPOINTMENTS
  VALUATION
  E_SIGNATURE
  GITHUB
  HISTORY
  TROUBLESHOOTING
}

enum DocumentType {
  CNPJ
  CPF
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  legalName              String?
  cnpj                   String?  @unique
  cpf                    String?  @unique
  documentType           DocumentType? @default(CNPJ)
  municipalRegistration  String?
  stateRegistration      String?
  /// Tiflux-parity: ativar/inativar cliente sem excluir (gap #5 do #49, confirmado ao vivo em #56).
  active                 Boolean  @default(true)
  /// Aba "Perfil do Cliente" no Tiflux real: segmentação livre do cliente.
  serviceType            String?
  healthStatus           String?
  /// Tiflux-parity (gap #3/#4 do #49, confirmado ao vivo em #57): campos extras
  /// da aba "Informações" do cliente real.
  workFolder             String?
  notes                  String?
  visibleToClients       Boolean  @default(true)
  quarterlyBilling       Boolean  @default(false)
  billingEmails          String?
  billingDueDay          Int?
  billingMethod          String?
  billingNotes           String?
  users     User[]
  credentials Credential[]
  contracts Contract[]
  commercialTickets Ticket[] @relation("CommercialOrganization")
  deskEvents OrganizationDeskEvent[]
  appointments Appointment[]
  addresses OrganizationAddress[]
  contacts  OrganizationContact[]
  /// Tiflux-parity: Mesa<->Cliente é N:N (confirmado ao vivo: 1 mesa pode servir
  /// vários clientes). Substitui o FK simples 1:1 da feature #54.
  serviceDesks ServiceDesk[]
  agentGroups  AgentGroup[]
  credentialFolders CredentialFolder[]
  createdAt DateTime @default(now())
}

model OrganizationDeskEvent {
  createdBy String?
  id String @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  serviceDeskId String
  linked Boolean
  createdAt DateTime @default(now())
  @@index([organizationId, createdAt])
}

model OrganizationAddress {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  zipCode        String?
  street         String?
  neighborhood   String?
  city           String?
  state          String?
  complement     String?
  createdAt      DateTime     @default(now())
}

model OrganizationContact {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String?
  phone          String?
  type           String?
  createdAt      DateTime     @default(now())
}

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  phone    String?
  extension String?
  password String
  role     Role    @default(AGENT)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  serviceDesks ServiceDesk[] @relation("AgentServiceDesks")
  agentGroups  AgentGroup[]  @relation("AgentGroupMembers")

  requestedTickets Ticket[]  @relation("RequesterTickets")
  assignedTickets  Ticket[]  @relation("AgentTickets")
  comments         Comment[]

  articles    Article[]
  audits      TicketAudit[]
  attachments TicketAttachment[]
  worklogs    Worklog[]
  costRates   TechnicianCostRate[]
  preAppointments PreAppointment[]
  apiTokens   ApiToken[]
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceDesk {
  id          String  @id @default(uuid())
  name        String
  displayName String?
  description String?
  tickets     Ticket[]
  agents      User[]   @relation("AgentServiceDesks")

  /// Tiflux-parity (#57): Mesa<->Cliente é N:N (confirmado ao vivo: 1 mesa
  /// pode servir vários clientes; cada cliente vê suas mesas em
  /// "Relacionamentos"). Mesas sem nenhum cliente vinculado = mesa
  /// global/compartilhada (pre-existing behavior da #54, agora via lista vazia
  /// em vez de organizationId nulo).
  organizations Organization[]
  contracts Contract[]
  agentGroups   AgentGroup[]

  businessHours  BusinessHour[]
  holidays       Holiday[]
  priorities     ServiceDeskPriority[]
  ticketSections ServiceDeskTicketSection[]
  stages         TicketStage[]

  /// Per-desk SLA targets (hours), overriding the global defaults in
  /// tickets.service.ts's SLA_HOURS when set. Each pair is nullable
  /// independently so a desk can override just e.g. CRITICAL while
  /// falling back to defaults for the rest.
  slaCriticalResponseHours Int?
  slaCriticalResolveHours  Int?
  slaHighResponseHours     Int?
  slaHighResolveHours      Int?
  slaMediumResponseHours   Int?
  slaMediumResolveHours    Int?
  slaLowResponseHours      Int?
  slaLowResolveHours       Int?

  active                   Boolean @default(true)
  acceptingNewTickets      Boolean @default(true)
  internalUse              Boolean @default(false)
  worklogsWithValuation    Boolean @default(true)
  allowCrossDeskInteraction Boolean @default(false)
  allowCancelTicket        Boolean @default(true)
  catalogRequiredOnOpen    Boolean @default(false)
  slaControlEnabled        Boolean @default(true)
  allowAddSlaHours         Boolean @default(false)
  allowPauseResumeSla      Boolean @default(true)
  reviewFlowEnabled        Boolean @default(false)
  evaluationEnabled        Boolean @default(false)
  openByAgentsOnly         Boolean @default(false)

  requireRequesterName       Boolean @default(false)
  requireRequesterEmail      Boolean @default(false)
  requireRequesterPhone      Boolean @default(false)
  requireRequesterExtension  Boolean @default(false)
  requireResourceGroup       Boolean @default(false)
  requireAttachments         Boolean @default(false)

  listedGroupsOnly         Boolean @default(false)
  unlistedCanCreateTicket  Boolean @default(true)

  defaultOpenStatus   TicketStatus @default(OPEN)
  defaultClosedStatus TicketStatus @default(CLOSED)

  allowReopenUnbilled          Boolean @default(true)
  allowReopenBilled            Boolean @default(false)
  reopenDefaultReplyUnbilled   String?
  reopenDefaultReplyBilled     String?

  reviewType            ServiceDeskReviewType?
  reviewDeadlineDays    Int?
  reviewNotifyEmail     Boolean @default(false)
  reviewReminder        Boolean @default(false)
  reviewReapplyReopen   Boolean @default(false)

  createdAt           DateTime             @default(now())
  serviceCatalogItems ServiceCatalogItem[]
}

model ServiceDeskPriority {
  id             String         @id @default(uuid())
  serviceDeskId  String
  serviceDesk    ServiceDesk    @relation(fields: [serviceDeskId], references: [id], onDelete: Cascade)
  ticketPriority TicketPriority
  label          String
  icon           String?
  sortOrder      Int            @default(0)
  enabled        Boolean        @default(true)

  @@unique([serviceDeskId, ticketPriority])
  @@index([serviceDeskId])
}

model ServiceDeskTicketSection {
  id            String                @id @default(uuid())
  serviceDeskId String
  serviceDesk   ServiceDesk           @relation(fields: [serviceDeskId], references: [id], onDelete: Cascade)
  key           ServiceDeskSectionKey
  enabled       Boolean               @default(true)
  sortOrder     Int                   @default(0)

  @@unique([serviceDeskId, key])
  @@index([serviceDeskId])
}

/// Tiflux-parity (#57): Grupo de Atendentes é uma entidade POR CLIENTE
/// (confirmado ao vivo na aba "Relacionamentos" do cliente real — cada
/// Organization tem seus próprios grupos com pessoas vinculadas), que
/// opcionalmente também fica associado a uma ou mais Mesas (N:N) para
/// aparecer na coluna "Grupos de atendentes" da tabela de Mesas do cliente.
model AgentGroup {
  id             String       @id @default(uuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        User[]       @relation("AgentGroupMembers")
  serviceDesks   ServiceDesk[]
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

/// One weekly working window for a ServiceDesk, e.g. Monday 08:00-18:00.
/// Multiple rows per weekday are allowed (e.g. split shift with lunch break).
/// A ServiceDesk with zero BusinessHour rows is treated as 24/7 (no restriction)
/// so SLA math keeps working for desks that haven't configured Expediente yet.
model BusinessHour {
  id      String @id @default(uuid())
  /// 0 = Sunday ... 6 = Saturday (JS Date#getDay() convention)
  weekday Int

  /// Stored as "HH:mm" (24h, UTC). NOTE (known v1 limitation): all SLA/
  /// business-hours math in `scheduling/business-hours.ts` operates in UTC,
  /// not the service desk's real-world local timezone. A desk configured
  /// "08:00–18:00" is actually treated as 08:00–18:00 UTC. Per-desk timezone
  /// support is tracked as follow-up work, not implemented in this release.
  startTime String
  endTime   String

  serviceDeskId String
  serviceDesk   ServiceDesk @relation(fields: [serviceDeskId], references: [id], onDelete: Cascade)

  @@index([serviceDeskId])
}

/// A single calendar date that does not count as business time for SLA
/// purposes (national/local holidays). Compared by date only (UTC midnight).
model Holiday {
  id   String   @id @default(uuid())
  date DateTime
  name String

  serviceDeskId String
  serviceDesk   ServiceDesk @relation(fields: [serviceDeskId], references: [id], onDelete: Cascade)

  @@index([serviceDeskId])
}

model Ticket {
  id                      String         @id @default(uuid())
  protocol                String         @unique
  title                   String
  description             String
  slaPausedAt             DateTime?
  slaAccumulatedPauseTime Int            @default(0)
  source                  TicketSource   @default(WEB)
  status                  TicketStatus   @default(OPEN)
  priority                TicketPriority @default(MEDIUM)

  requesterId String
  commercialOrganizationId String?
  commercialOrganization Organization? @relation("CommercialOrganization", fields: [commercialOrganizationId], references: [id], onDelete: Restrict)
  requester   User   @relation("RequesterTickets", fields: [requesterId], references: [id])

  agentId String?
  agent   User?   @relation("AgentTickets", fields: [agentId], references: [id])

  serviceDeskId String
  serviceDesk   ServiceDesk @relation(fields: [serviceDeskId], references: [id])

  stageId String?
  stage   TicketStage? @relation(fields: [stageId], references: [id])

  responseDeadline DateTime?
  resolveDeadline  DateTime?

  csatScore   Int?
  csatComment String?
  csatToken   String? @unique

  comments       Comment[]
  audits         TicketAudit[]
  parentTicketId String?
  parentTicket   Ticket?       @relation("ParentChildTickets", fields: [parentTicketId], references: [id])
  subTickets     Ticket[]      @relation("ParentChildTickets")

  resourceGroup String?

  checklists  TicketChecklist[]
  attachments TicketAttachment[]
  worklogs    Worklog[]
  preAppointments PreAppointment[]
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceDeskId, status])
  @@index([requesterId])
  @@index([stageId])
}

model TicketStage {
  id            String  @id @default(uuid())
  serviceDeskId String
  serviceDesk   ServiceDesk @relation(fields: [serviceDeskId], references: [id], onDelete: Cascade)
  name          String
  position      Int     @default(0)
  isInitial     Boolean @default(false)
  isFinal       Boolean @default(false)

  tickets          Ticket[]
  transitionsFrom  TicketStageTransition[] @relation("StageTransitionsFrom")
  transitionsTo    TicketStageTransition[] @relation("StageTransitionsTo")

  @@index([serviceDeskId, position])
}

model TicketStageTransition {
  id          String      @id @default(uuid())
  fromStageId String
  fromStage   TicketStage @relation("StageTransitionsFrom", fields: [fromStageId], references: [id], onDelete: Cascade)
  toStageId   String
  toStage     TicketStage @relation("StageTransitionsTo", fields: [toStageId], references: [id], onDelete: Cascade)

  @@unique([fromStageId, toStageId])
  @@index([fromStageId])
  @@index([toStageId])
}

model Article {
  id       String  @id @default(uuid())
  title    String
  content  String
  isPublic Boolean @default(true) // true = public FAQ, false = internal

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  tags String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TicketAudit {
  id      String  @id @default(uuid())
  action  String
  prevVal String?
  newVal  String?

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])
  userId   String
  user     User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model TicketChecklist {
  id    String @id @default(uuid())
  title String

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  items TicketChecklistItem[]
}

model TicketChecklistItem {
  id          String  @id @default(uuid())
  text        String
  isCompleted Boolean @default(false)

  checklistId String
  checklist   TicketChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
}

model TicketAttachment {
  id           String @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  fileUrl      String

  ticketId   String
  ticket     Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User   @relation(fields: [uploaderId], references: [id])

  createdAt DateTime @default(now())
}

model Comment {
  id         String  @id @default(uuid())
  content    String
  isInternal Boolean @default(false)

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  @@index([ticketId])
}

model ServiceCatalogCategory {
  id          String  @id @default(uuid())
  name        String
  description String?
  isActive    Boolean @default(true)

  items ServiceCatalogItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceCatalogItem {
  id          String  @id @default(uuid())
  title       String
  description String?
  icon        String?

  categoryId String
  category   ServiceCatalogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  defaultServiceDeskId String
  defaultServiceDesk   ServiceDesk @relation(fields: [defaultServiceDeskId], references: [id])

  defaultPriority TicketPriority @default(MEDIUM)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Cofre de Senhas: Multi-tenant password vault entries.
model Credential {
  id             String       @id @default(uuid())
  name           String
  username       String?
  password       String
  url            String?
  description    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  folderId       String?
  folder         CredentialFolder? @relation(fields: [folderId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([folderId])
}

/// Cofre de Senhas: folder/group that organizes credentials within an
/// Organization's vault (Tiflux-parity: "árvore de pastas" of DMTE-80).
/// Credentials with a null folderId sit at the vault's root, equivalent to
/// the Tiflux root level.
model CredentialFolder {
  id             String       @id @default(uuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  credentials    Credential[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

/// Actions tracked by CredentialAuditLog (Tiflux-parity audit trail,
/// DMTE-80). Restore/history/attachment actions are intentionally omitted:
/// the spec only implements the actions that have a real emitter today.
enum CredentialAction {
  CREATE_FOLDER
  DELETE_FOLDER
  CREATE_CREDENTIAL
  UPDATE_CREDENTIAL
  DELETE_CREDENTIAL
  REVEAL_CREDENTIAL
  COPY_USERNAME
  COPY_PASSWORD
}

/// Cofre de Senhas: audit trail of every folder/credential action
/// (DMTE-80 acceptance criteria #2). Fields that reference other entities
/// (organizationId/folderId/credentialId/actorId) are deliberately plain
/// scalars with NO Prisma relation/FK — this is a point-in-time snapshot
/// (targetName/actorName included) that must keep existing even after the
/// folder/credential/user it refers to is deleted.
model CredentialAuditLog {
  id             String            @id @default(uuid())
  organizationId String
  action         CredentialAction
  folderId       String?
  credentialId   String?
  targetName     String
  actorId        String
  actorName      String
  ipAddress      String?
  createdAt      DateTime          @default(now())

  @@index([organizationId, createdAt])
}

enum ContractType {
  FIXED_COVERAGE
  HOURS_LIMIT
  FIXED_PROJECT
  MONTHLY_HOURS
  HOURLY
}

model Contract {
  id                 String       @id @default(uuid())
  name               String?
  startsAt           DateTime?
  endsAt             DateTime?
  includedMinutes    Int?
  excessHourlyRateCents Int?
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  type               ContractType @default(FIXED_COVERAGE)
  active             Boolean      @default(true)
  approved           Boolean      @default(false)
  fixedPriceCents    Int?
  estimatedMinutes   Int?
  scope              String?
  hourlyRateCents    Int?
  monthlyFeeCents    Int?
  serviceDesks       ServiceDesk[]
  terms              ContractTerm[]
  lifecycleEvents    ContractLifecycleEvent[]
  preAppointments    PreAppointment[]
  monthlyValue       Float?
  lastAmendmentValue Float?
  hoursLimit         Int?
  adjustmentDate     DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  worklogs           Worklog[]
}

model ContractTerm {
  createdBy String?
  id String @id @default(uuid())
  contractId String
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  effectiveFrom DateTime
  approved Boolean @default(false)
  active Boolean @default(true)
  startsAt DateTime?
  endsAt DateTime?
  type ContractType
  includedMinutes Int?
  hourlyRateCents Int?
  excessHourlyRateCents Int?
  monthlyFeeCents Int?
  fixedPriceCents Int?
  estimatedMinutes Int?
  scope String?
  serviceDeskIds Json
  createdAt DateTime @default(now())
  @@unique([contractId, effectiveFrom])
}

model ContractLifecycleEvent {
  id String @id @default(uuid())
  contractId String
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  effectiveFrom DateTime
  approved Boolean
  active Boolean
  startsAt DateTime?
  endsAt DateTime?
  createdBy String?
  createdAt DateTime @default(now())
  @@index([contractId, effectiveFrom])
}

model TechnicianCostRate {
  createdBy String?
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  effectiveFrom DateTime
  hourlyCostCents Int
  createdAt DateTime @default(now())
  @@unique([userId, effectiveFrom])
}

enum AttendanceType {
  REMOTE
  ON_SITE
}

enum ValuationType {
  CONTRACT
  GUARANTEE
  MANUAL
  BONUS
}

model PreAppointment {
  contractId String?
  contract Contract? @relation(fields: [contractId], references: [id], onDelete: Restrict)
  id        String    @id @default(uuid())
  beginning DateTime
  ending    DateTime?
  initTime  String
  endTime   String?
  ticketId  String
  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  createdAt DateTime  @default(now())

  @@index([ticketId])
}

model Worklog {
  voidedAt DateTime?
  voidedBy String?
  id             String         @id @default(uuid())
  description    String
  minutes        Int      // Tempo apontado, derivado de (endTime - startTime)
  startTime      DateTime
  endTime        DateTime
  attendanceType AttendanceType @default(REMOTE)
  billable       Boolean        @default(true)
  valuationType  ValuationType  @default(CONTRACT)
  value          Float?   // Valor calculado (CONTRACT), 0 (GUARANTEE) ou informado manualmente (MANUAL)
  valueCents     Int?
  costCents      Int?
  bonusReason    String?
  sourcePreAppointmentId String? @unique
  contractId     String?
  contract       Contract?      @relation(fields: [contractId], references: [id], onDelete: Restrict)
  valuationSnapshot Json?
  ticketId       String
  ticket         Ticket         @relation(fields: [ticketId], references: [id])
  authorId       String
  author         User           @relation(fields: [authorId], references: [id])
  createdAt      DateTime       @default(now())

  @@index([contractId, startTime])
}

model ApiToken {
  id         String    @id @default(uuid())
  name       String
  prefix     String    @db.VarChar(16)
  tokenHash  String
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([prefix])
}

enum AppointmentType {
  AGENDA
  ABSENCE
  VACATION
}

model Appointment {
  id             String          @id @default(uuid())
  title          String
  description    String?
  startTime      DateTime
  endTime        DateTime
  type           AppointmentType @default(AGENDA)
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id])
  ticketId       String?
  ticket         Ticket?         @relation(fields: [ticketId], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([startTime, endTime])
}

