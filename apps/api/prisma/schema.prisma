generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  AGENT_MASTER
  AGENT
  CLIENT_MASTER
  CLIENT
}

enum TicketSource {
  WEB
  EMAIL
  WHATSAPP
}

enum TicketStatus {
  ESCALATED
  PENDING_CUSTOMER
  ON_HOLD
  PENDING_APPROVAL
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  legalName              String?
  cnpj                   String?  @unique
  municipalRegistration  String?
  stateRegistration      String?
  users     User[]
  credentials Credential[]
  contracts Contract[]
  addresses OrganizationAddress[]
  contacts  OrganizationContact[]
  createdAt DateTime @default(now())
}

model OrganizationAddress {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  zipCode        String?
  street         String?
  neighborhood   String?
  city           String?
  state          String?
  complement     String?
  createdAt      DateTime     @default(now())
}

model OrganizationContact {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String?
  phone          String?
  type           String?
  createdAt      DateTime     @default(now())
}

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  phone    String?
  password String
  role     Role    @default(AGENT)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  serviceDesks ServiceDesk[] @relation("AgentServiceDesks")

  requestedTickets Ticket[]  @relation("RequesterTickets")
  assignedTickets  Ticket[]  @relation("AgentTickets")
  comments         Comment[]

  articles    Article[]
  audits      TicketAudit[]
  attachments TicketAttachment[]
  worklogs    Worklog[]
  apiTokens   ApiToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceDesk {
  id      String   @id @default(uuid())
  name    String
  tickets Ticket[]
  agents  User[]   @relation("AgentServiceDesks")

  businessHours BusinessHour[]
  holidays      Holiday[]

  createdAt           DateTime             @default(now())
  serviceCatalogItems ServiceCatalogItem[]
}

/// One weekly working window for a ServiceDesk, e.g. Monday 08:00-18:00.
/// Multiple rows per weekday are allowed (e.g. split shift with lunch break).
/// A ServiceDesk with zero BusinessHour rows is treated as 24/7 (no restriction)
/// so SLA math keeps working for desks that haven't configured Expediente yet.
model BusinessHour {
  id      String @id @default(uuid())
  /// 0 = Sunday ... 6 = Saturday (JS Date#getDay() convention)
  weekday Int

  /// Stored as "HH:mm" (24h, UTC). NOTE (known v1 limitation): all SLA/
  /// business-hours math in `scheduling/business-hours.ts` operates in UTC,
  /// not the service desk's real-world local timezone. A desk configured
  /// "08:00–18:00" is actually treated as 08:00–18:00 UTC. Per-desk timezone
  /// support is tracked as follow-up work, not implemented in this release.
  startTime String
  endTime   String

  serviceDeskId String
  serviceDesk   ServiceDesk @relation(fields: [serviceDeskId], references: [id], onDelete: Cascade)

  @@index([serviceDeskId])
}

/// A single calendar date that does not count as business time for SLA
/// purposes (national/local holidays). Compared by date only (UTC midnight).
model Holiday {
  id   String   @id @default(uuid())
  date DateTime
  name String

  serviceDeskId String
  serviceDesk   ServiceDesk @relation(fields: [serviceDeskId], references: [id], onDelete: Cascade)

  @@index([serviceDeskId])
}

model Ticket {
  id                      String         @id @default(uuid())
  protocol                String         @unique
  title                   String
  description             String
  slaPausedAt             DateTime?
  slaAccumulatedPauseTime Int            @default(0)
  source                  TicketSource   @default(WEB)
  status                  TicketStatus   @default(OPEN)
  priority                TicketPriority @default(MEDIUM)

  requesterId String
  requester   User   @relation("RequesterTickets", fields: [requesterId], references: [id])

  agentId String?
  agent   User?   @relation("AgentTickets", fields: [agentId], references: [id])

  serviceDeskId String
  serviceDesk   ServiceDesk @relation(fields: [serviceDeskId], references: [id])

  responseDeadline DateTime?
  resolveDeadline  DateTime?

  csatScore   Int?
  csatComment String?
  csatToken   String? @unique

  comments       Comment[]
  audits         TicketAudit[]
  parentTicketId String?
  parentTicket   Ticket?       @relation("ParentChildTickets", fields: [parentTicketId], references: [id])
  subTickets     Ticket[]      @relation("ParentChildTickets")

  checklists  TicketChecklist[]
  attachments TicketAttachment[]
  worklogs    Worklog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceDeskId, status])
  @@index([requesterId])
}

model Article {
  id       String  @id @default(uuid())
  title    String
  content  String
  isPublic Boolean @default(true) // true = public FAQ, false = internal

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  tags String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TicketAudit {
  id      String  @id @default(uuid())
  action  String
  prevVal String?
  newVal  String?

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])
  userId   String
  user     User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model TicketChecklist {
  id    String @id @default(uuid())
  title String

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  items TicketChecklistItem[]
}

model TicketChecklistItem {
  id          String  @id @default(uuid())
  text        String
  isCompleted Boolean @default(false)

  checklistId String
  checklist   TicketChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
}

model TicketAttachment {
  id           String @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  fileUrl      String

  ticketId   String
  ticket     Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User   @relation(fields: [uploaderId], references: [id])

  createdAt DateTime @default(now())
}

model Comment {
  id         String  @id @default(uuid())
  content    String
  isInternal Boolean @default(false)

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  @@index([ticketId])
}

model ServiceCatalogCategory {
  id          String  @id @default(uuid())
  name        String
  description String?
  isActive    Boolean @default(true)

  items ServiceCatalogItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceCatalogItem {
  id          String  @id @default(uuid())
  title       String
  description String?
  icon        String?

  categoryId String
  category   ServiceCatalogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  defaultServiceDeskId String
  defaultServiceDesk   ServiceDesk @relation(fields: [defaultServiceDeskId], references: [id])

  defaultPriority TicketPriority @default(MEDIUM)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Cofre de Senhas: Multi-tenant password vault entries.
model Credential {
  id             String       @id @default(uuid())
  name           String
  username       String?
  password       String
  url            String?
  description    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

enum ContractType {
  FIXED_COVERAGE
  HOURS_LIMIT
}

model Contract {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  type               ContractType @default(FIXED_COVERAGE)
  active             Boolean      @default(true)
  monthlyValue       Float?
  lastAmendmentValue Float?
  hoursLimit         Int?
  adjustmentDate     DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Worklog {
  id          String   @id @default(uuid())
  description String
  minutes     Int      // Tempo apontado
  billable    Boolean  @default(true)
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id])
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
}

model ApiToken {
  id         String    @id @default(uuid())
  name       String
  prefix     String    @db.VarChar(16)
  tokenHash  String
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([prefix])
}
