  "criteria": [
    {
      "id": "AC-01",
      "description": "após um merge pela fila com `CD (Produção)` verde, o card pai da entrega recebe um comentário do workflow mencionando o `dev_ultra_lider`, com SHA, PR, link do run e versão em produção, em até 2 minutos do fim do job.",
      "tests": [
        "CommentBodyTests.test_success_starts_with_leader_mention_and_carries_sha_pr_run_and_version",
        "NotifyTests.test_posts_content_with_workspace_and_bearer_headers",
        "NotifyTests.test_delivery_with_registry_entry_resolves_its_parent",
        "CommentBodyTests.test_version_that_differs_from_the_deployed_commit_is_said_so",
        "DeliveryTests.test_single_delivery_line_names_the_delivery",
        "CommentBodyTests.test_probe_that_failed_is_not_verified_instead_of_different",
        "NotifyTests.test_unreachable_production_is_posted_as_not_verified"
      ]
    },
    {
      "id": "AC-02",
      "description": "se `staging` ou `production` falhar, o card recebe o comentário de falha com o job e o link do run.",
      "tests": [
        "CommentBodyTests.test_failure_names_the_job_and_the_run",
        "OutcomeTests.test_staging_failure_is_reported_as_staging",
        "OutcomeTests.test_production_failure_is_reported_as_production",
        "WorkflowTests.test_notify_runs_after_cd_whatever_its_result",
        "OutcomeTests.test_cancelled_job_shows_its_own_result",
        "NotifyTests.test_failure_comments_without_probing_production"
      ]
    },
    {
      "id": "AC-03",
      "description": "commit na `main` sem PR ou sem `Aponta-Delivery` não gera comentário nem falha o CD.",
      "tests": [
        "NotifyTests.test_commit_without_pr_does_not_comment",
        "NotifyTests.test_pr_without_delivery_line_does_not_comment",
        "NotifyTests.test_two_distinct_deliveries_do_not_comment",
        "DeliveryTests.test_no_pr_or_no_line_names_nothing",
        "DeliveryTests.test_two_distinct_deliveries_name_nothing",
        "NotifyTests.test_delivery_without_manifest_does_not_comment"
      ]
    },
    {
      "id": "AC-04",
      "description": "erro ao chamar a API do Multica não altera o resultado do workflow de CD.",
      "tests": [
        "NotifyTests.test_http_error_never_fails_the_deploy",
        "NotifyTests.test_network_error_never_fails_the_deploy",
        "NotifyTests.test_token_is_redacted_from_logged_errors",
        "WorkflowTests.test_notify_never_fails_the_deploy",
        "WorkflowTests.test_token_is_only_read_by_notify",
        "NotifyTests.test_github_lookup_failure_does_not_fail_the_deploy",
        "NotifyTests.test_missing_token_does_not_comment_nor_fail",
        "WorkflowTests.test_checkout_failure_never_fails_the_deploy",
        "WorkflowTests.test_delivery_contract_runs_these_tests"
      ]
    },
    {
