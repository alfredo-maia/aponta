AssertionError: 'id: previous' not found in 'name: CD (Produção)\n\n# Entrega em duas etapas, sempre do mesmo commit e das mesmas imagens:\n#   staging   constrói as imagens do commit uma vez, sobe o staging, roda seed sintético,\n#             smoke e fluxos críticos, e grava o registro do commit;\n#   produção  só sobe um commit cujo registro diz que o staging passou com aquelas imagens,\n#             e nunca um commit anterior ao que está no ar.\n# As regras estão em scripts/aponta_release.py (com testes) e em docs/delivery/RELEASE.md.\non:\n  # Never trigger directly on push — that let deploy race the CI workflow\n  # on the exact same commit. Deploy only after the CI workflow itself\n  # reports a conclusion for a push to main.\n  workflow_run:\n    workflows: ["CI"]\n    types: [completed]\n    branches: [main]\n\n# Um ciclo por vez no repositório inteiro: outro run não troca a versão do staging\n# enquanto ela é validada, e nenhum run em andamento é cancelado (uma migração\n# interrompida deixaria o banco pela metade). Isto não é uma fila: o GitHub mantém só\n# o run pendente mais novo, e por isso qualquer run publica a ponta da main.\nconcurrency:\n  group: deploy-production\n  cancel-in-progress: false\n\npermissions: {}\n\njobs:\n  resolve:\n    name: Commit a publicar\n    runs-on: ubuntu-latest\n    permissions:\n      actions: read\n      contents: read\n    # Guard clause: only when the upstream CI run was a push to main AND it\n    # actually succeeded. A failed/cancelled CI run never reaches the deploy.\n    if: github.event.workflow_run.conclusion == \'success\' && github.event.workflow_run.event == \'push\'\n    outputs:\n      sha: ${{ steps.target.outputs.sha }}\n    steps:\n      # What ships is always the tip of main, never "the commit whose CI just\n      # finished": CI runs of commits that leave the merge queue together finish\n      # out of order (DMTE-472). Any run may publish the tip, but only once the\n      # tip\'s own CI is green; until then it stops here, and the tip\'s CI\n      # triggers another run when it finishes.\n      - name: Resolve the commit to deploy\n        id: target\n        env:\n          GH_TOKEN: ${{ github.token }}\n          TRIGGER_SHA: ${{ github.event.workflow_run.head_sha }}\n        run: |\n          tip=$(gh api "repos/$GITHUB_REPOSITORY/commits/main" -q .sha)\n          if [ "$tip" != "$TRIGGER_SHA" ]; then\n            green=$(gh api "repos/$GITHUB_REPOSITORY/actions/workflows/ci.yml/runs?head_sha=$tip&event=push&status=success" -q .total_count)\n            if [ "$green" = "0" ]; then\n              echo "CI de $TRIGGER_SHA passou, mas a ponta da main é $tip e o CI dela ainda não passou. Nada a publicar agora."\n              exit 0\n            fi\n          fi\n          echo "sha=$tip" >> "$GITHUB_OUTPUT"\n\n  staging:\n    name: Staging (deploy, testes, registro)\n    needs: resolve\n    if: needs.resolve.outputs.sha != \'\'\n    runs-on: ubuntu-latest\n    environment: staging\n    steps:\n      - name: Build once, deploy to staging and test\n        uses: appleboy/ssh-action@0ff4204d59e8e51228ff73bce53f80d53301dee2 # v1.2.5\n        env:\n          DEPLOY_SHA: ${{ needs.resolve.outputs.sha }}\n        with:\n          host: ${{ secrets.DEPLOY_HOST }}\n          username: ${{ secrets.DEPLOY_USER }}\n          key: ${{ secrets.DEPLOY_KEY }}\n          port: 2000\n          envs: DEPLOY_SHA\n          command_timeout: 40m\n          script: |\n            set -e\n            cd /home/hermes/repos/aponta\n            git fetch origin main\n            # A ferramenta roda da árvore exportada do próprio commit, nunca do checkout,\n            # que pode estar em outra branch.\n            release="$HOME/deploy/aponta/releases/$DEPLOY_SHA"\n            mkdir -p "$release"\n            git archive "$DEPLOY_SHA" | tar -x -C "$release"\n            python3 "$release/scripts/aponta_release.py" init-staging\n            python3 "$release/scripts/aponta_release.py" stage --sha "$DEPLOY_SHA"\n\n  production:\n    name: Produção (promoção do commit validado)\n    needs: [resolve, staging]\n    runs-on: ubuntu-latest\n    # Para exigir aprovação humana antes de produção, configure revisores obrigatórios\n    # neste environment (Settings > Environments > production). Sem isso a promoção é\n    # automática quando o staging passa.\n    environment: production\n    steps:\n      - name: Promote the validated images to production\n        uses: appleboy/ssh-action@0ff4204d59e8e51228ff73bce53f80d53301dee2 # v1.2.5\n        env:\n          DEPLOY_SHA: ${{ needs.resolve.outputs.sha }}\n        with:\n          host: ${{ secrets.DEPLOY_HOST }}\n          username: ${{ secrets.DEPLOY_USER }}\n          key: ${{ secrets.DEPLOY_KEY }}\n          port: 2000\n          envs: DEPLOY_SHA\n          command_timeout: 20m\n          script: |\n            set -e\n            python3 "$HOME/deploy/aponta/releases/$DEPLOY_SHA/scripts/aponta_release.py" promote --sha "$DEPLOY_SHA"\n\n  # Devolve o resultado do CD ao card Multica da entrega, para o líder não agendar horário.\n  # Nunca altera o resultado do CD: o script termina com 0 e o passo tem continue-on-error.\n  notify:\n    name: Aviso ao card Multica\n    needs: [resolve, staging, production]\n    if: always() && needs.resolve.outputs.sha != \'\'\n    runs-on: ubuntu-latest\n    permissions:\n      contents: read\n      pull-requests: read\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n        with:\n          ref: ${{ needs.resolve.outputs.sha }}\n          persist-credentials: false\n        continue-on-error: true\n      - name: Comment the CD result on the delivery card\n        continue-on-error: true\n        env:\n          GH_TOKEN: ${{ github.token }}\n          MULTICA_TOKEN: ${{ secrets.MULTICA_TOKEN }}\n          SHA: ${{ needs.resolve.outputs.sha }}\n          STAGING_RESULT: ${{ needs.staging.result }}\n          PRODUCTION_RESULT: ${{ needs.production.result }}\n        run: python3 scripts/avisar_card.py\n'

